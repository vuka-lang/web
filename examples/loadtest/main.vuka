// Command loadtest is the server of the live-page load test: a dashboard over
// Postgres, its caps lifted, and on a second port pprof and its stats. See
// README.md.
package main

import (
	"context"
	"encoding/json"
	"flag"
	"log"
	"net/http"
	"net/http/pprof"
	"os"
	"runtime"
	"runtime/metrics"
	"strconv"
	"strings"
	"time"

	"github.com/vuka-lang/web/v2"
	"github.com/vuka-lang/web/v2/examples/loadtest/pages"
	"github.com/vuka-lang/web/v2/examples/loadtest/store"
)

func main() {
	addr := flag.String("addr", ":18090", "the app's address")
	debug := flag.String("debug", "127.0.0.1:18091", "pprof's and the stats' address")
	dbURL := flag.String("db", os.Getenv("LOADTEST_DB"), "the Postgres URL; add pool_max=N for the pool")
	owners := flag.Int("owners", 1000, "owners to seed")
	perOwner := flag.Int("orders", 100, "orders per owner to seed")
	checks := flag.Bool("checks", true, "run a LiveCheck querying the database")
	checkEvery := flag.Duration("check-every", 30*time.Second, "web.LiveCheckEvery")
	block := flag.Int("block-rate", 0, "runtime.SetBlockProfileRate (ns; 0 off)")
	mutex := flag.Int("mutex-fraction", 0, "runtime.SetMutexProfileFraction (0 off)")
	flag.Parse()

	ctx := context.Background()
	if err := store.Connect(ctx, *dbURL, *owners, *perOwner); err != nil {
		log.Fatal(err)
	}
	runtime.SetBlockProfileRate(*block)
	runtime.SetMutexProfileFraction(*mutex)
	go serveDebug(*debug)

	opts := []web.Option{pages.Routes(), web.LiveMaxConns(0), web.LiveMaxConnsPerIP(0), web.LiveCheckEvery(*checkEvery)}
	if *checks {
		opts = append(opts, web.LiveCheck(checkOwner))
	}
	if err := web.New(opts...).Run(*addr); err != nil {
		log.Fatal(err)
	}
}

// checkOwner is a check as an app's would be: a query per page, per period.
func checkOwner(ctx context.Context) error {
	owner := 1
	if r := web.Request(ctx); r != nil {
		if n, err := strconv.Atoi(r.URL.Query().Get("u")); err == nil && n > 0 {
			owner = n
		}
	}
	return store.Check(ctx, owner)
}

func serveDebug(addr string) {
	mux := http.NewServeMux()
	mux.HandleFunc("/debug/pprof/", pprof.Index)
	mux.HandleFunc("/debug/pprof/profile", pprof.Profile)
	mux.HandleFunc("/debug/stats", stats)
	log.Println(http.ListenAndServe(addr, mux))
}

// stats is the numbers each sample of the client's run records.
func stats(w http.ResponseWriter, r *http.Request) {
	var m runtime.MemStats
	runtime.ReadMemStats(&m)
	out := map[string]any{
		"goroutines":   runtime.NumGoroutine(),
		"gomaxprocs":   runtime.GOMAXPROCS(0),
		"heap_alloc":   m.HeapAlloc,
		"heap_inuse":   m.HeapInuse,
		"heap_sys":     m.HeapSys,
		"heap_idle":    m.HeapIdle,
		"heap_released": m.HeapReleased,
		"stack_inuse":  m.StackInuse,
		"sys":          m.Sys,
		"next_gc":      m.NextGC,
		"num_gc":       m.NumGC,
		"pause_total_ms": float64(m.PauseTotalNs) / 1e6,
		"gc_cpu_fraction": m.GCCPUFraction,
		"db_ms":        store.DBTime.Snapshot(),
		"check_ms":     store.CheckTime.Snapshot(),
	}
	for name, key := range map[string]string{
		"/sched/latencies:seconds":     "sched_latency_ms",
		"/sched/pauses/total/gc:seconds": "gc_pause_ms",
		"/sync/mutex/wait/total:seconds": "",
		"/cpu/classes/gc/total:cpu-seconds": "",
		"/cpu/classes/total:cpu-seconds": "",
	} {
		s := []metrics.Sample{{Name: name}}
		metrics.Read(s)
		switch s[0].Value.Kind() {
		case metrics.KindFloat64Histogram:
			if key != "" {
				out[key] = quantiles(s[0].Value.Float64Histogram())
			}
		case metrics.KindFloat64:
			out[strings.NewReplacer("/", "_", ":", "_").Replace(strings.TrimPrefix(name, "/"))] = s[0].Value.Float64()
		}
	}
	w.Header().Set("Content-Type", "application/json")
	json.NewEncoder(w).Encode(out)
}

func quantiles(h *metrics.Float64Histogram) map[string]float64 {
	var total uint64
	for _, c := range h.Counts {
		total += c
	}
	out := map[string]float64{"count": float64(total)}
	for _, q := range []struct {
		name string
		at   float64
	}{{"p50", .5}, {"p99", .99}, {"p999", .999}, {"p9999", .9999}, {"max", 1}} {
		var seen uint64
		for i, c := range h.Counts {
			seen += c
			if float64(seen) >= q.at*float64(total) && total > 0 {
				out[q.name] = h.Buckets[i+1] * 1000
				break
			}
		}
	}
	return out
}
