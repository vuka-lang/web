// Command loadtest is the server of the live-page load test. Two scenarios: a
// dashboard over Postgres, and pages that read nothing outside the process, one
// that subscribes to a topic and one that answers events. Its caps are lifted,
// it can listen on several ports, and on another port it serves pprof, its
// metrics and an endpoint that broadcasts. See README.md.
package main

import (
	"context"
	"flag"
	"log"
	"net"
	"net/http"
	"os"
	"os/signal"
	"runtime"
	"strconv"
	"syscall"
	"time"

	"github.com/vuka-lang/web/v2"
	"github.com/vuka-lang/web/v2/examples/loadtest/pages"
	"github.com/vuka-lang/web/v2/examples/loadtest/store"
)

func main() {
	addr := flag.String("addr", "127.0.0.1:18090", "the app's address")
	ports := flag.Int("ports", 1, "listen on this many consecutive ports from addr's: a client's connections to one address are limited by its ephemeral ports")
	debug := flag.String("debug", "127.0.0.1:18099", "pprof's, the metrics' and the broadcast endpoint's address")
	scenario := flag.String("scenario", "pg", "pg (the Postgres dashboard at /) or mem (/counter and /feed, no database)")
	dbURL := flag.String("db", os.Getenv("LOADTEST_DB"), "the Postgres URL; add pool_max=N for the pool")
	owners := flag.Int("owners", 1000, "owners to seed")
	perOwner := flag.Int("orders", 100, "orders per owner to seed")
	checks := flag.Bool("checks", true, "run a LiveCheck querying the database")
	checkEvery := flag.Duration("check-every", 30*time.Second, "web.LiveCheckEvery")
	block := flag.Int("block-rate", 0, "runtime.SetBlockProfileRate (ns; 0 off)")
	mutex := flag.Int("mutex-fraction", 0, "runtime.SetMutexProfileFraction (0 off)")
	flag.Parse()

	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()
	opts := []web.Option{pages.Routes(), web.LiveMaxConns(0), web.LiveMaxConnsPerIP(0), web.LiveCheckEvery(*checkEvery)}
	switch *scenario {
	case "pg":
		if err := store.Connect(ctx, *dbURL, *owners, *perOwner); err != nil {
			log.Fatal(err)
		}
		if *checks {
			opts = append(opts, web.LiveCheck(checkOwner))
		}
	case "mem":
	default:
		log.Fatalf("unknown scenario %q", *scenario)
	}
	runtime.SetBlockProfileRate(*block)
	runtime.SetMutexProfileFraction(*mutex)

	app := web.New(opts...)
	if err := app.Start(ctx); err != nil {
		log.Fatal(err)
	}
	go serveDebug(*debug, app)
	if err := serve(ctx, app, *addr, *ports); err != nil {
		log.Fatal(err)
	}
	sctx, done := context.WithTimeout(context.Background(), 10*time.Second)
	defer done()
	app.Stop(sctx)
}

// serve listens on ports consecutive ports from addr's and returns when ctx
// ends.
func serve(ctx context.Context, app *web.App, addr string, ports int) error {
	host, p, err := net.SplitHostPort(addr)
	if err != nil {
		return err
	}
	first, err := strconv.Atoi(p)
	if err != nil {
		return err
	}
	handler := countLive(app.Handler())
	var servers []*http.Server
	for i := range max(1, ports) {
		ln, err := net.Listen("tcp", net.JoinHostPort(host, strconv.Itoa(first+i)))
		if err != nil {
			return err
		}
		srv := &http.Server{Handler: handler, ReadHeaderTimeout: 10 * time.Second}
		servers = append(servers, srv)
		log.Printf("loadtest: listening on http://%s", ln.Addr())
		go srv.Serve(ln)
	}
	<-ctx.Done()
	for _, srv := range servers {
		sctx, done := context.WithTimeout(context.Background(), 5*time.Second)
		srv.Shutdown(sctx)
		done()
	}
	return nil
}

// checkOwner is a check as an app's would be: a query per page, per period.
func checkOwner(ctx context.Context) error {
	owner := 1
	if r := web.Request(ctx); r != nil {
		if n, err := strconv.Atoi(r.URL.Query().Get("u")); err == nil && n > 0 {
			owner = n
		}
	}
	return store.Check(ctx, owner)
}
