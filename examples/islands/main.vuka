// Command islands is a live page with a Vue island imported from its file:
// the compiler reads the island's props from Week.vue, so its tag is
// type-checked like any component's. Its picked prop is a client state the
// page shares (two-way), onBook a live view method (an event prop), and
// booked server state the island follows as the page changes it (a live
// prop). pages/applicants.vuka.html is a page backed by a component. As an app
// of its own module (web is its island root, web.IslandRoot): npm install
// in web, then vuka run.
package main

import (
	"log"

	"github.com/vuka-lang/web"
	"github.com/vuka-lang/web/examples/islands/pages"
	"github.com/vuka-lang/web/examples/islands/registry"
)

func main() {
	app := web.New(pages.Routes(), web.IslandRoot("web"), web.Provide(registry.New))
	if err := app.Run(":" + web.Env("PORT", "8080")); err != nil {
		log.Fatal(err)
	}
}
