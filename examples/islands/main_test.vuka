package main

import (
	"io"
	"net/http/httptest"
	"strings"
	"testing"

	"github.com/vuka-lang/web"
	"github.com/vuka-lang/web/examples/islands/pages"
	"github.com/vuka-lang/web/examples/islands/registry"
)

// The pages render their islands' tags; the islands' bundle is the
// frontend build's, which the tests don't need.
func TestPages(t *testing.T) {
	srv := httptest.NewServer(web.New(pages.Routes(), web.Provide(registry.New)).Handler())
	defer srv.Close()
	for path, want := range map[string]string{
		"/":                `data-vk-island="Week"`,
		"/applicants?q=gr": `&#34;rows&#34;:[{&#34;name&#34;:&#34;Grace&#34;`,
	} {
		res, err := srv.Client().Get(srv.URL + path)
		if err != nil {
			t.Fatal(err)
		}
		b, _ := io.ReadAll(res.Body)
		res.Body.Close()
		if res.StatusCode != 200 || !strings.Contains(string(b), want) {
			t.Errorf("GET %s: %d %s", path, res.StatusCode, b)
		}
	}
}
