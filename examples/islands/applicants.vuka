package main

import (
	"context"
	"strings"

	"github.com/vuka-lang/ui"
	"github.com/vuka-lang/web"
)

// Applicants is a page backed by a component: its template is
// Applicants.vue. The exported fields are what the component reads
// (useLive: live.rows.value); Q, bound, is one it sets as the visitor types,
// kept in the address's ?q=, and onChange runs after. db is the server's own.
// Without ui.Live the page is stateless: each update carries the page's
// signed props back and gets the new ones.
@web.Get("/applicants")
@ui.Island("./web/components/Applicants.vue")
type Applicants struct {
	Q    string      `json:"q" url:"q" bind:"q"`
	Rows []Applicant `json:"rows"`
	db   *Registry
}

type Applicant struct {
	Name string `json:"name"`
	Role string `json:"role"`
}

// Registry is the applicants' store, provided to the app.
type Registry struct{ all []Applicant }

func NewRegistry() *Registry {
	return &Registry{all: []Applicant{{"Ada", "engineer"}, {"Grace", "admiral"}, {"Alan", "mathematician"}}}
}

// LiveSchema declares the hooks: a stateless page has no ui.Live, which
// gives a live page's the attributes @ui.Mount and @ui.OnChange.
func (a *Applicants) LiveSchema(l *ui.LiveSchema) {
	l.Mount(a.mount)
	l.OnChange(a.onChange)
}

func (a *Applicants) mount(_ context.Context) error {
	a.Rows = a.find(a.Q)
	return nil
}

func (a *Applicants) onChange(_ context.Context, _ ui.Changed) error {
	if a.Q != "" && len(a.Q) < 2 {
		return web.Invalid{"q": "type at least 2 letters"}
	}
	a.Rows = a.find(a.Q)
	return nil
}

func (a *Applicants) find(q string) []Applicant {
	var out []Applicant
	for _, x := range a.db.all {
		if strings.Contains(strings.ToLower(x.Name), strings.ToLower(q)) {
			out = append(out, x)
		}
	}
	return out
}
