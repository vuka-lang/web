package main

import (
	"io"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"
	"time"

	"github.com/vuka-lang/web"
	"github.com/vuka-lang/web/crontest"
	"github.com/vuka-lang/web/mail/mailtest"
)

func get(t *testing.T, srv *httptest.Server, method, path, body string, header ...string) (int, string) {
	t.Helper()
	req, _ := http.NewRequest(method, srv.URL+path, strings.NewReader(body))
	for i := 0; i+1 < len(header); i += 2 {
		req.Header.Set(header[i], header[i+1])
	}
	client := &http.Client{CheckRedirect: func(*http.Request, []*http.Request) error { return http.ErrUseLastResponse }}
	res, err := client.Do(req)
	if err != nil {
		t.Fatal(err)
	}
	defer res.Body.Close()
	b, _ := io.ReadAll(res.Body)
	return res.StatusCode, string(b) + res.Header.Get("Location")
}

func TestPets(t *testing.T) {
	app := web.New(web.Provide(OpenDB, mailtest.New()))
	srv := httptest.NewServer(app.Handler())
	defer srv.Close()
	for _, c := range []struct {
		method, path, body string
		header             []string
		code               int
		want               string
	}{
		{"GET", "/", "", nil, 200, "<title>Home · Pets</title>"},
		{"GET", "/pets", "", nil, 200, `<li><a href="/pets/1">Rex</a> (dog)</li>`},
		{"GET", "/pets/2", "", nil, 200, "<p>A cat, pet #2.</p>"},
		{"GET", "/pets/9", "", nil, 404, "<p>no pet 9</p>"},
		{"GET", "/pets/x", "", nil, 400, "is not an integer"},
		{"GET", "/api/pets", "", nil, 200, `{"id":1,"name":"Rex","kind":"dog"}`},
		{"POST", "/api/pets", `{"name":"Bo","kind":"parrot"}`, []string{"Content-Type", "application/json"}, 200, `{"id":3,"name":"Bo","kind":"parrot"}`},
		{"POST", "/api/pets", `{"kind":"parrot"}`, []string{"Content-Type", "application/json"}, 400, `"name is required"`},
		{"POST", "/pets", `name=Kit&kind=cat`, []string{"Content-Type", "application/x-www-form-urlencoded"}, 303, "/pets/4"},
		{"POST", "/pets", `name=+&kind=cat`, []string{"Content-Type", "application/x-www-form-urlencoded"}, 400, "<p>a pet needs a name</p>"},
		{"GET", "/admin/pets", "", nil, 200, `"name":"Kit"`},
		{"DELETE", "/admin/pets/2", "", nil, 401, "unauthorized"},
		{"DELETE", "/admin/pets/2", "", []string{"Authorization", "Bearer letmein"}, 204, ""},
		{"DELETE", "/admin/pets/2", "", []string{"Authorization", "Bearer letmein"}, 404, "not found"},
	} {
		code, body := get(t, srv, c.method, c.path, c.body, c.header...)
		if code != c.code || !strings.Contains(body, c.want) {
			t.Errorf("%s %s: %d %q; want %d containing %q", c.method, c.path, code, body, c.code, c.want)
		}
	}
}

func TestSignup(t *testing.T) {
	m := mailtest.New()
	app := web.New(web.Provide(OpenDB, m))
	srv := httptest.NewServer(app.Handler())
	defer srv.Close()
	form := []string{"Content-Type", "application/x-www-form-urlencoded"}
	if code, body := get(t, srv, "POST", "/signup", "name=Ada&email=ada@example.com", form...); code != 303 || body != "/signup/sent" {
		t.Fatalf("sign up: %d %q", code, body)
	}
	msg := mailtest.Last(t, m)
	if msg.Recipients[0] != "ada@example.com" || msg.Subject != "Welcome to Pets" || !strings.Contains(msg.HTML, "<h1>Welcome, Ada</h1>") ||
		!strings.Contains(msg.Text, "Welcome, Ada\n\nThanks for signing up") {
		t.Fatalf("the welcome email: %+v", msg)
	}
	_, link, _ := strings.Cut(msg.Text, "Confirm my address (")
	link, _, _ = strings.Cut(link, ")")
	if code, body := get(t, srv, "GET", strings.TrimPrefix(link, srv.URL), ""); code != 200 || !strings.Contains(body, "Thanks, Ada: your address is confirmed.") {
		t.Errorf("confirm %s: %d %s", link, code, body)
	}
	if code, body := get(t, srv, "POST", "/signup", "name=Bo&email=not-an-address", form...); code != 400 || !strings.Contains(body, "an email address") {
		t.Errorf("a bad address: %d %s", code, body)
	}

	// The cron forgets sign-ups nobody confirmed within a day.
	owners, _ := web.Resolve[*Owners](app)
	old := owners.Add("Cy", "cy@example.com")
	owners.db.owners[old.Token] = Owner{Name: "Cy", Token: old.Token, Joined: time.Now().Add(-25 * time.Hour)}
	if err := crontest.Run(app, "forgetUnconfirmed"); err != nil {
		t.Fatal(err)
	}
	if _, ok := owners.Confirm(old.Token); ok {
		t.Error("an old sign-up survived the cron")
	}
	if code, _ := get(t, srv, "GET", "/signup/confirm?token="+old.Token, ""); code != 404 {
		t.Errorf("an expired link: %d", code)
	}
}
