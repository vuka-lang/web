// Command pets is a small web app built with github.com/vuka-lang/web.
package main

import (
	"embed"
	"io/fs"
	"log"

	"github.com/vuka-lang/web"
	"github.com/vuka-lang/web/mail"
)

//go:embed static
var static embed.FS

// services are the app's, which its pages, handlers and hooks take as
// parameters.
func services(app *web.App) {
	app.Service(NewPetStore)
	app.Service(NewOwners)
}

func main() {
	app := web.New(mail.Provide()) // reads .env files first: see .env.example
	app.Provide(OpenDB)
	services(app)
	assets, _ := fs.Sub(static, "static")
	app.Static("/assets", assets)
	if err := app.Run(":" + web.Env("PORT", "8080")); err != nil {
		log.Fatal(err)
	}
}
