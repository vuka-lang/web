// Command pets is a small web app built with github.com/vuka-lang/web.
package main

import (
	"embed"
	"io/fs"
	"log"

	"github.com/vuka-lang/web"
)

//go:embed static
var static embed.FS

func main() {
	app := web.New() // reads .env files first: see .env.example
	app.Provide(OpenDB)
	assets, _ := fs.Sub(static, "static")
	app.Static("/assets", assets)
	if err := app.Run(":" + web.Env("PORT", "8080")); err != nil {
		log.Fatal(err)
	}
}
