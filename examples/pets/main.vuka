// Command pets is a small web app built with github.com/vuka-lang/web/v2: its
// pages are the files under pages/, its JSON API and template views the
// handlers beside main.
package main

import (
	"embed"
	"io/fs"
	"log"

	"github.com/vuka-lang/web/v2"
	"github.com/vuka-lang/web/v2/examples/pets/pages"
	"github.com/vuka-lang/web/v2/examples/pets/store"
	"github.com/vuka-lang/web/v2/mail"
)

//go:embed static
var static embed.FS

// services are the app's, which its pages, handlers and hooks take as
// parameters.
func services(app *web.App) {
	app.Service(store.NewPetStore)
	app.Service(store.NewOwners)
}

func main() {
	app := web.New(pages.Routes(), mail.Provide()) // reads .env files first: see .env.example
	app.Provide(store.OpenDB)
	services(app)
	assets, _ := fs.Sub(static, "static")
	app.Static("/assets", assets)
	if err := app.Run(":" + web.Env("PORT", "8080")); err != nil {
		log.Fatal(err)
	}
}
