package main

import (
	"net/http"

	"github.com/vuka-lang/web"
	"github.com/vuka-lang/web/examples/pets/model"
	"github.com/vuka-lang/web/examples/pets/views"
	"github.com/vuka-lang/ui"
)

// PetList fills views.PetsPage's parameters by name: title, pets.
type PetList struct {
	Title string
	Pets  []model.Pet
}

@web.Get("/")
func Home(r *http.Request) ui.Node {
	return <views.Layout title="Home">
		<h1>Welcome</h1>
		<p>Try <a href="/pets">the pets</a> or <code>GET /api/pets</code>.</p>
	</views.Layout>
}

@web.Get("/pets")
@web.Template("views/pets.templ")
func ListPets(store *PetStore) Result[PetList] {
	pets := store.All()?
	return Ok(PetList{Title: "All pets", Pets: pets})
}

@web.Template("views/pet.html")
@web.Get("/pets/{id}")
func ShowPet(id int, store *PetStore) Result[model.Pet] { return store.Find(id) }

@web.Post("/pets")
func AddPet(in model.NewPet, store *PetStore) (web.Redirect, error) {
	p := store.Add(in)?
	return web.Redirect("/pets/" + itoa(p.ID)), nil
}
