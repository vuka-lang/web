package main

import (
	"context"
	"log/slog"
	"time"

	"github.com/vuka-lang/ui/v2"
	"github.com/vuka-lang/web/v2"
	"github.com/vuka-lang/web/v2/examples/pets/store"
	"github.com/vuka-lang/web/v2/examples/pets/views"
)

// ConfirmSignup is the link of the welcome email: it confirms the address
// and answers with a page saying so.
@web.Get("/signup/confirm")
func ConfirmSignup(token string, owners *store.Owners) (ui.Node, error) {
	ow, ok := owners.Confirm(token)
	if !ok {
		return nil, web.Status(404, "this link has expired; sign up again")
	}
	return views.Confirmed{Name: ow.Name}, nil
}

// forgetUnconfirmed drops the sign-ups nobody confirmed within a day.
@web.Cron("@every 10m")
func forgetUnconfirmed(ctx context.Context, owners *store.Owners) {
	if n := owners.ForgetUnconfirmed(time.Now().Add(-24 * time.Hour)); n > 0 {
		slog.InfoContext(ctx, "forgot unconfirmed sign-ups", "n", n)
	}
}
