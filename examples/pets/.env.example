# Copy to .env (or .env.local, kept out of git) and fill in.
PORT=8080
# The bearer token of the /admin/pets routes.
ADMIN_TOKEN=change-me
# Mail: the log driver (the default) logs each message and sends nothing.
MAIL_DRIVER=log
MAIL_FROM=Pets <hello@pets.example>
# For a real server:
# MAIL_DRIVER=smtp
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_ENCRYPTION=starttls
# MAIL_USERNAME=pets
# MAIL_PASSWORD=change-me
