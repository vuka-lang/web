package main

import (
	"net/http"

	"github.com/vuka-lang/ui"
	"github.com/vuka-lang/web"
	"github.com/vuka-lang/web/auth"
)

// Shell is the pages' document.
func Shell(title string, children ui.Node) ui.Node {
	return <html lang="en">
		<head>
			<meta charset="utf-8" />
			<meta name="viewport" content="width=device-width, initial-scale=1" />
			<title>{title} · Vuka auth</title>
			<style>{css}</style>
			<script>{ui.Safe(onError)}</script>
		</head>
		<body>
			<main>{children}</main>
		</body>
	</html>
}

// livePage is the layout of the @web.Live pages.
func livePage(page ui.Node) ui.Node { return <Shell title="Board">{page}</Shell> }

const css = `body { font: 16px/1.5 system-ui, sans-serif; max-width: 40rem; margin: 2rem auto; padding: 0 1rem }
.vk-login { display: grid; gap: .6rem; max-width: 20rem } .vk-login label { display: grid } .vk-login-error, #error { color: crimson }
nav { display: flex; gap: 1rem; align-items: center } nav form { margin: 0 }`

// onError shows what the server refused (vk:error) under the board.
const onError = `document.addEventListener("vk:error", (e) => { const p = document.getElementById("error"); if (p) p.textContent = e.detail.message; });`

// Login is the page auth sends visitors to; it must be public.
@web.Get("/login")
@auth.Public
func Login(r *http.Request) ui.Node {
	return <Shell title="Sign in">
		<h1>Sign in</h1>
		<auth.LoginForm next={r.URL.Query().Get("next")} error={auth.LoginError(r)} />
	</Shell>
}

// Home needs a sign-in, as every route does unless marked public: me is
// never nil here.
@web.Get("/")
func Home(me *auth.Identity) ui.Node {
	return <Shell title="Home">
		<Nav me={me} />
		<h1>Hello, {name(me)}</h1>
		<p><a href="/board">The notice board</a> is live: it shows who you are, and only admins may clear it.</p>
		<p>The API takes a bearer token: <code>POST /auth/token</code> with your login and password, then <code>GET /api/notices</code> with <code>Authorization: Bearer …</code>.</p>
	</Shell>
}

// Nav says who is signed in, with a sign-out button (a POST, as a sign-out
// must be).
func Nav(me *auth.Identity) ui.Node {
	return <nav>
		<a href="/">Home</a> <a href="/board">Board</a>
		<span class="who">Signed in as {name(me)}</span>
		<form method="post" action="/auth/logout"><button class="logout">Sign out</button></form>
	</nav>
}
