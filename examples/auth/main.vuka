// Command auth shows github.com/vuka-lang/web/v2/auth: a login page, pages and
// a live board that need a sign-in, an action only admins may take, and a
// JSON API that takes bearer tokens. Its pages are the files under
// pages/.
//
//	vuka run ./examples/auth     then open http://localhost:8080
//
// Sign in as ada@example.com / correct horse battery (an admin) or
// bob@example.com / hunter2hunter2.
package main

import (
	"log"

	"github.com/vuka-lang/ui/v2"
	"github.com/vuka-lang/web/v2"
	"github.com/vuka-lang/web/v2/auth"
	"github.com/vuka-lang/web/v2/examples/auth/accounts"
	"github.com/vuka-lang/web/v2/examples/auth/components"
	"github.com/vuka-lang/web/v2/examples/auth/notices"
	"github.com/vuka-lang/web/v2/examples/auth/pages"
)

// options are the app's, shared by main and the tests.
func options() []web.Option {
	return []web.Option{
		pages.Routes(),
		auth.Module(auth.Config{
			Endpoints: "/auth", // POST /auth/login, /auth/logout, /auth/token; GET /auth/me
			Roles:     map[string][]string{"admin": {"notices.*"}},
			// Users: the service implementing auth.Users (accounts.Users).
		}),
		web.LiveLayout(livePage),
		web.OptionFunc(services),
	}
}

// services are the app's, which its pages, handlers and hooks take as
// parameters.
func services(app *web.App) {
	app.Service(accounts.NewUsers)
	app.Service(notices.New)
}

// livePage is the layout of the live pages.
func livePage(page ui.Node) ui.Node { return components.Shell{Title: "Board", Children: page} }

func main() {
	if err := web.New(options()...).Run(""); err != nil {
		log.Fatal(err)
	}
}
