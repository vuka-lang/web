package main

import (
	"context"
	"strings"

	"github.com/vuka-lang/web/v2"
	"github.com/vuka-lang/web/v2/auth"
	"github.com/vuka-lang/web/v2/examples/auth/accounts"
	"github.com/vuka-lang/web/v2/examples/auth/notices"
)

// The API: a browser's session cookie or a bearer token from
// POST /auth/token, whichever the request carries.

@web.Get("/api/notices")
@auth.Requires("notices.read")
func ListNotices(n *notices.Notices) []notices.Notice { return n.All() }

@web.Post("/api/notices")
@auth.Requires("notices.write")
func PostNotice(ctx context.Context, me auth.Identity, in notices.Form, n *notices.Notices) Result[notices.Notice] {
	if strings.TrimSpace(in.Text) == "" {
		return Err(web.BadRequest("text is required"))
	}
	x := n.Add(accounts.Name(&me), in.Text)
	web.Broadcast(ctx, "notices", notices.Changed{})
	return Ok(x)
}
