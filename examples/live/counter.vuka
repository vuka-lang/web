package main

import (
	"context"

	"github.com/vuka-lang/web"
	"github.com/vuka-lang/ui"
)

// Counter is a page of its own at /counter (?start=3 sets its Start), and a
// component anywhere else.
@web.Live("/counter")
type Counter struct {
	ui.Live
	Start int
	n     int
}

@ui.Mount
func (c *Counter) mount(ctx context.Context) error { c.n = c.Start; return nil }

func (c *Counter) Inc() { c.n++ }
func (c *Counter) Dec() { c.n-- }

func (c *Counter) Render() ui.Node {
	return <div class="counter">
		<button type="button" onClick={c.Dec}>−</button>
		<output>{c.n}</output>
		<button type="button" onClick={c.Inc}>+</button>
	</div>
}
