package main

import (
	"fmt"
	"net/http"
	"slices"
	"time"

	"github.com/vuka-lang/web"
	"github.com/vuka-lang/ui"
)

// Commands is a page of JS commands only — a menu, a dialog, a copy
// button: the browser runs them, and the page never connects.
@web.Get("/commands")
func Commands(r *http.Request) ui.Node {
	return <Shell title="Commands">
		<h1>Commands</h1>
		<button
			id="menu-btn"
			type="button"
			aria-expanded="false"
			onClick={ui.JS.ToggleClass("#menu", "open").ToggleAttr(ui.This, "aria-expanded", "true", "false")}
		>
			Menu
		</button>
		<ul id="menu" class="menu"><li>One</li><li>Two</li></ul>
		<button
			id="open"
			type="button"
			onClick={ui.JS.PushFocus().Show("#dialog", ui.Transition("fade", "faded", "shown"), ui.Time(200*time.Millisecond)).FocusFirst("#dialog")}
		>
			Open the dialog
		</button>
		<div id="dialog" class="dialog" hidden onKeyDown={ui.JS.Key("Escape").Hide(ui.This).PopFocus()}>
			<input id="name" placeholder="Your name" />
			<button id="close" type="button" onClick={ui.JS.Hide("#dialog").PopFocus()}>Close</button>
		</div>
		<p>
			<input id="code" value="go run ." readonly />
			<button id="copy" type="button" onClick={ui.JS.Copy("#code")}>Copy</button>
		</p>
	</Shell>
}

// Chores is a live list whose menu opens in the browser, whose deletes ask
// first, and which pushes a flash to its status line after each delete.
@web.Live("/chores")
type Chores struct {
	ui.Live
	chores []string
	picked string
	done   int
}

func (c *Chores) Mount() { c.chores = []string{"wash", "cook", "read"} }

func (c *Chores) Pick(e ui.Event) { c.picked = e.Value }

func (c *Chores) Delete(e ui.Event) {
	c.chores = slices.DeleteFunc(c.chores, func(s string) bool { return s == e.Value })
	c.done++
	c.PushJS(ui.JS.On(ui.Ref("status")).AddClass("flash").SetAttr("data-done", fmt.Sprint(c.done)))
}

func (c *Chores) Render() ui.Node {
	return <section class="chores">
		<button class="pick" type="button" onClick={ui.JS.RemoveClass(ui.Ref("menu"), "hidden")}>Pick one</button>
		<ul ref="menu" class="menu hidden">
			{for _, ch := range c.chores {
				<li>
					<button
						type="button"
						value={ch}
						onClick={ui.JS.AddClass(ui.Ref("menu"), "hidden").Push(c.Pick)}
					>
						{ch}
					</button>
				</li>
			}}
		</ul>
		<output>{c.picked}</output>
		<ul class="list">
			{for _, ch := range c.chores {
				<li key={ch} id={"chore-" + ch}>
					{ch}
					<button
						class="del"
						type="button"
						value={ch}
						onClick={ui.JS.Confirm("Delete " + ch + "?").Push(c.Delete)}
					>
						delete
					</button>
				</li>
			}}
		</ul>
		<p ref="status" class="status">{len(c.chores)} left</p>
	</section>
}
