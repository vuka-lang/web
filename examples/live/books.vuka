package main

import (
	"fmt"
	"sync/atomic"

	"github.com/vuka-lang/web"
	"github.com/vuka-lang/ui"
)

// Book is a book of the shelf.
type Book struct {
	ID     int    `json:"id"`
	Title  string `json:"title"`
	Author string `json:"author"`
}

var books = []Book{
	{1, "Things Fall Apart", "Chinua Achebe"}, {2, "Petals of Blood", "Ngũgĩ wa Thiong'o"},
	{3, "Half of a Yellow Sun", "Chimamanda Ngozi Adichie"}, {4, "Season of Migration to the North", "Tayeb Salih"},
	{5, "The Famished Road", "Ben Okri"}, {6, "Paradise", "Abdulrazak Gurnah"},
	{7, "Nervous Conditions", "Tsitsi Dangarembga"}, {8, "So Long a Letter", "Mariama Bâ"},
	{9, "Weep Not, Child", "Ngũgĩ wa Thiong'o"}, {10, "The Beautyful Ones Are Not Yet Born", "Ayi Kwei Armah"},
	{11, "Americanah", "Chimamanda Ngozi Adichie"}, {12, "By the Sea", "Abdulrazak Gurnah"},
	{13, "Disgrace", "J. M. Coetzee"}, {14, "The Joys of Motherhood", "Buchi Emecheta"},
	{15, "Arrow of God", "Chinua Achebe"}, {16, "Kintu", "Jennifer Nansubuga Makumbi"},
	{17, "Afterlives", "Abdulrazak Gurnah"}, {18, "The Promise", "Damon Galgut"},
}

const perPage = 5

var shelves atomic.Int64 // how many shelves have mounted, to tell one from the next

// Shelf lists the books a page at a time. Its pager links patch it: the
// same component, moved to another page of the list, with no page load.
// A book's link navigates to the book's own page.
@web.Live("/books")
type Shelf struct {
	ui.Live
	Page    int // ?page=, for the first render
	page    int
	rows    []Book
	mount   int64
	patches int
}

// ShelfParams is what a patch of the shelf's URL brings to Update.
type ShelfParams struct {
	web.URLParams
	Page int // ?page=
}

func (s *Shelf) Mount() {
	s.mount = shelves.Add(1)
	s.show(s.Page)
}

// Update takes the URL the pager patched the page to.
func (s *Shelf) Update(p ShelfParams) {
	s.patches++
	s.show(p.Page)
}

func (s *Shelf) show(page int) {
	s.page = min(max(page, 1), pages())
	s.rows = books[(s.page-1)*perPage : min(s.page*perPage, len(books))]
}

func pages() int { return (len(books) + perPage - 1) / perPage }

func shelfURL(page int) string { return fmt.Sprint("/books?page=", page) }

func bookURL(id int) string { return fmt.Sprint("/books/", id) }

func (s *Shelf) Render() ui.Node {
	return <section class="shelf">
		<h1>Books</h1>
		<ol start={(s.page-1)*perPage + 1}>
			{for _, b := range s.rows {
				<li key={b.ID}><ui.Link href={bookURL(b.ID)}>{b.Title}</ui.Link> <small>{b.Author}</small></li>
			}}
		</ol>
		<p class="pager">
			{if s.page > 1 { <ui.Link href={shelfURL(s.page - 1)} patch class="prev">Previous</ui.Link> }}
			<span class="at">page {s.page} of {pages()}</span>
			{if s.page < pages() { <ui.Link href={shelfURL(s.page + 1)} patch class="next">Next</ui.Link> }}
		</p>
		<p><small class="mount">shelf #{s.mount}, patched {s.patches} times</small></p>
		<p><ui.Link href="/books.json">The list as JSON</ui.Link></p>
	</section>
}

// BookPage is a book's page, in a layout of its own. Its next link patches
// it (ID is bound again from the URL, and Render reads it); its buttons move
// the page from the server and from a JS command.
@web.Live("/books/{id}", web.Layout(bookLayout))
type BookPage struct {
	ui.Live
	ID int
}

func (p *BookPage) book() Book { return books[min(max(p.ID, 1), len(books))-1] }

// Done sends the reader back to the book's page of the shelf.
func (p *BookPage) Done() { p.PushNavigate(shelfURL((p.book().ID-1)/perPage + 1)) }

func (p *BookPage) Render() ui.Node {
	b := p.book()
	return <article class="book">
		<h1>{b.Title}</h1>
		<p class="author">by {b.Author}</p>
		<p>
			{if b.ID < len(books) { <ui.Link href={bookURL(b.ID + 1)} patch class="next">Next book</ui.Link> }}
			<ui.Link href={shelfURL(1)} class="shelf">All books</ui.Link>
		</p>
		<button id="done" type="button" onClick={p.Done}>Done reading</button>
		<button id="first" type="button" onClick={ui.JS.AddClass(ui.This, "going").Patch(bookURL(1))}>First book</button>
	</article>
}

func bookLayout(page ui.Node) ui.Node {
	return <Shell title="Book" head={<style>{bookCSS}</style>}>{page}</Shell>
}

const bookCSS = `.book h1 { font-family: Georgia, serif } .book .author { color: #555 }`

// BooksJSON is the list as JSON: not a page, so a link to it is a page load.
@web.Get("/books.json")
func BooksJSON() []Book { return books }
