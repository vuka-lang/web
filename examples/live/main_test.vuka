package main

import (
	"fmt"
	"io"
	"net/http"
	"net/http/httptest"
	"strings"
	"testing"

	"github.com/vuka-lang/web"
	"github.com/vuka-lang/web/internal/chrome"
	"github.com/vuka-lang/web/internal/livetree"
)

// Until the Vuka live session speaks protocol v2, the tests answer v2 joins
// with livetree's stand-in.
func init() { livetree.Install() }

func server(t *testing.T, opts ...web.Option) *httptest.Server {
	srv := httptest.NewServer(web.New(append([]web.Option{web.LiveLayout(livePage)}, opts...)...).Handler())
	t.Cleanup(srv.Close)
	return srv
}

// protocols runs a browser test once per live protocol version, the server
// capped to it; each page checks it speaks it.
func protocols(t *testing.T, test func(t *testing.T, open func(path string) *chrome.Page)) {
	b := chrome.Launch(t)
	for _, v := range []int{1, 2} {
		t.Run(fmt.Sprint("v", v), func(t *testing.T) {
			srv := server(t, web.LiveProtocol(v))
			test(t, func(path string) *chrome.Page {
				p := b.Open(srv.URL + path)
				p.Wait(fmt.Sprintf(`document.documentElement.dataset.vkProtocol === "%d"`, v))
				return p
			})
		})
	}
}

// perEvent logs the payload bytes the page received per reply since w.
func perEvent(t *testing.T, p *chrome.Page, w chrome.Wire, what string) {
	now := p.Wire()
	if n := now.Msgs - w.Msgs; n > 0 {
		t.Logf("%s: %d replies, %d bytes, %d bytes per reply (render: %d bytes)", what, n, now.In-w.In, (now.In-w.In)/n, w.In)
	}
}

func TestPages(t *testing.T) {
	srv := server(t)
	for path, want := range map[string]string{
		"/":                `<output>10</output>`,
		"/counter?start=3": `<output>3</output>`,
		"/todo":            `<p class="left">0 left</p>`,
		"/chat/go":         `<h2>#go</h2>`,
	} {
		res, err := http.Get(srv.URL + path)
		if err != nil {
			t.Fatal(err)
		}
		b, _ := io.ReadAll(res.Body)
		res.Body.Close()
		if res.StatusCode != 200 || !strings.Contains(string(b), want) || !strings.Contains(string(b), "data-vk-token=") {
			t.Errorf("GET %s: %d %s", path, res.StatusCode, b)
		}
	}
}

func TestBrowserCounter(t *testing.T) {
	protocols(t, func(t *testing.T, open func(string) *chrome.Page) {
		p := open("/counter?start=3")
		p.Click(".counter button:last-of-type")
		p.WaitText("output", "4")
		p.Click(".counter button:first-of-type")
		p.Click(".counter button:first-of-type")
		p.WaitText("output", "2")
		w := p.Wire()
		for i := 3; i <= 22; i++ {
			p.Click(".counter button:last-of-type")
			p.WaitText("output", fmt.Sprint(i))
		}
		perEvent(t, p, w, "counter")

		home := open("/")
		home.Click(".counter button:last-of-type")
		home.WaitText("output", "11")
	})
}

func TestBrowserTodo(t *testing.T) {
	protocols(t, func(t *testing.T, open func(string) *chrome.Page) {
		p := open("/todo")
		w := p.Wire()
		p.Eval(`window.errs = []; document.addEventListener("vk:error", (e) => errs.push(e.detail.message))`, nil)
		p.Type("input[name=text]", "milk")
		p.Press("Enter")
		p.WaitText("#todo-1 span", "milk")
		p.Wait(`document.querySelector("input[name=text]").value === ""`)
		p.Type("input[name=text]", "eggs")
		p.Click("form button")
		p.WaitText("#todo-2 span", "eggs")
		p.WaitText(".left", "2 left")
		for i, it := range []string{"bread", "apples", "cheese"} {
			p.Type("input[name=text]", it)
			p.Press("Enter")
			p.WaitText(fmt.Sprintf("#todo-%d span", i+3), it)
		}

		p.Click("#todo-1 input[type=checkbox]")
		p.WaitText(".left", "4 left")
		p.Wait(`document.querySelector("#todo-1").className === "done" && document.querySelector("#todo-1 input").checked`)

		// Reorder: the keyed items move, the same elements.
		p.Eval(`document.querySelector("#todo-2").marked = true`, nil)
		p.Click("button.sort")
		p.Wait(`[...document.querySelectorAll("li span")].map((s) => s.textContent).join() === "apples,bread,cheese,eggs,milk"`)
		p.Wait(`document.querySelector("#todo-2").marked && document.querySelector("#todo-1 input").checked`)
		p.Click("button.sort")
		p.Wait(`[...document.querySelectorAll("li span")].map((s) => s.textContent).join() === "milk,eggs,bread,apples,cheese"`)
		p.Click("button.sort")
		p.Wait(`document.querySelector("li span").textContent === "apples"`)
		p.Click("#todo-3 button")
		p.Wait(`[...document.querySelectorAll("li span")].map((s) => s.textContent).join() === "apples,cheese,eggs,milk"`)

		// A field with focus keeps its value and caret while the list under
		// it changes.
		p.Type("input[type=search]", "e")
		p.Wait(`document.querySelectorAll("li").length === 3`)
		p.Type("input[type=search]", "g")
		p.Wait(`document.querySelectorAll("li").length === 1`)
		p.Wait(`document.activeElement.type === "search" && document.activeElement.value === "eg" && document.activeElement.selectionStart === 2`)
		p.Click("#todo-2 button")
		p.Wait(`document.querySelectorAll("li").length === 0`)
		p.WaitText(".left", "2 left")

		p.Click("input[name=text]")
		p.Press("Enter")
		p.Wait(`errs[0] === "write something first"`)
		perEvent(t, p, w, "todo")
	})
}

func TestBrowserReconnect(t *testing.T) {
	protocols(t, func(t *testing.T, open func(string) *chrome.Page) {
		p := open("/todo")
		p.Type("input[name=text]", "milk")
		p.Press("Enter")
		p.WaitText("#todo-1 span", "milk")
		p.Eval(`window.marker = 1`, nil)
		p.Drop()
		p.Wait(`document.documentElement.dataset.vkState !== "connected"`)
		p.Wait(`document.documentElement.dataset.vkState === "connected" && !document.querySelector("li")`) // a fresh mount
		p.Type("input[name=text]", "eggs")
		p.Press("Enter")
		p.WaitText("#todo-1 span", "eggs")
		p.Click("#todo-1 input[type=checkbox]")
		p.WaitText(".left", "0 left")
		p.Wait(`window.marker === 1`)
	})
}

func TestBrowserChat(t *testing.T) {
	protocols(t, func(t *testing.T, open func(string) *chrome.Page) {
		ann, bob := open("/chat/go"), open("/chat/go")
		ann.Type("form.name input", "ann")
		ann.Press("Enter")
		ann.Wait(`document.querySelector("form.say")`)
		bob.WaitText(".lines li:last-child", "ann joined")
		bob.Type("form.name input", "bob")
		bob.Press("Enter")
		ann.WaitText(".lines li:last-child", "bob joined")

		ann.Type("form.say input", "hello bob")
		ann.Press("Enter")
		bob.WaitText(".lines li:last-child", "ann: hello bob")
		ann.WaitText(".lines li:last-child", "ann: hello bob")

		late := open("/chat/go")
		late.WaitText(".lines li:last-child", "ann: hello bob")
		other := open("/chat/rust")
		if n := other.Text(".lines"); n != "" {
			t.Errorf("another room shows %q", n)
		}
	})
}

func TestBrowserCommands(t *testing.T) {
	srv := server(t)
	p := chrome.Launch(t).Visit(srv.URL + "/commands")
	p.Click("#menu-btn")
	p.Wait(`document.querySelector("#menu").className === "menu open" && document.querySelector("#menu-btn").getAttribute("aria-expanded") === "true"`)
	p.Click("#open")
	p.Wait(`getComputedStyle(document.querySelector("#dialog")).display === "block" && document.activeElement.id === "name"`)
	p.Wait(`document.querySelector("#dialog").className === "dialog"`) // the transition's classes are gone
	p.Press("Escape")
	p.Wait(`getComputedStyle(document.querySelector("#dialog")).display === "none" && document.activeElement.id === "open"`)
	p.Eval(`navigator.clipboard.writeText = (t) => { window.copied = t; return Promise.resolve(); }`, nil)
	p.Click("#copy")
	p.Wait(`window.copied === "go run ." && document.querySelector("#copy").hasAttribute("data-copied")`)
	p.Wait(`window.__wire.sockets.length === 0`) // no live parts: no connection
}

func TestBrowserChores(t *testing.T) {
	protocols(t, func(t *testing.T, open func(string) *chrome.Page) {
		p := open("/chores")
		p.Click("button.pick")
		p.Wait(`document.querySelector("[data-vk-ref=menu]").className === "menu"`)
		p.Click(`[data-vk-ref=menu] button[value=cook]`)
		p.WaitText("output", "cook")
		p.Wait(`document.querySelector("[data-vk-ref=menu]").className === "menu hidden"`)

		p.Eval(`window.confirm = () => false`, nil)
		p.Click("#chore-read .del")
		p.Click("button.pick")
		p.Click(`[data-vk-ref=menu] button[value=wash]`)
		p.WaitText("output", "wash")
		p.Wait(`document.querySelector("#chore-read")`)

		p.Eval(`window.confirm = (m) => (window.asked = m, true)`, nil)
		p.Click("#chore-read .del")
		p.Wait(`!document.querySelector("#chore-read") && window.asked === "Delete read?"`)
		p.Wait(`(() => { const s = document.querySelector("[data-vk-ref=status]"); return s.textContent === "2 left" && s.className === "status flash" && s.dataset.done === "1"; })()`)
		p.Click("button.pick")
		p.Click(`[data-vk-ref=menu] button[value=cook]`)
		p.Wait(`document.querySelector("[data-vk-ref=status]").className === "status flash"`) // the server renders it as before
	})
}

func TestBrowserLikes(t *testing.T) {
	protocols(t, func(t *testing.T, open func(string) *chrome.Page) {
		p := open("/likes")
		count := `document.querySelector("[data-vk-ref=count]").textContent`
		like := `document.querySelector("#like")`

		// Closed: the like shows, then is taken back, and the error shows.
		p.Click("#toggle")
		p.WaitText("#toggle", "Open likes")
		p.Click("#like")
		p.Wait(count + ` === "6" && ` + like + `.className === "like liked"`)
		p.Wait(count + ` === "5" && ` + like + `.className === "like" && ` + like + `.hasAttribute("data-vk-failed") && !document.querySelector("[data-vk-ref=like-error]").hidden`)

		// Open: the predicted count, which the server's render confirms.
		p.Click("#toggle")
		p.WaitText("#toggle", "Close likes")
		p.Click("#like")
		p.Wait(count + ` === "6" && ` + like + `.className === "like liked"`)
		p.Wait(`!` + like + `.hasAttribute("data-vk-pending") && !` + like + `.hasAttribute("data-vk-failed")`)
		p.Click("#like")
		p.Wait(count + ` === "7" && !` + like + `.hasAttribute("data-vk-pending")`)

		// A note goes at once; the one the server keeps comes back.
		p.Click("#note-milk button")
		p.Wait(`!document.querySelector("#note-milk")`)
		p.Click("#note-keep button")
		p.Wait(`!document.querySelector("[data-vk-ref=note-error]").hidden && getComputedStyle(document.querySelector("#note-keep")).display !== "none"`)
	})
}
