package main

import (
	"net/http"

	"github.com/vuka-lang/web"
	"github.com/vuka-lang/ui"
)

// Shell is the pages' document; head adds to its head. Its links move a
// live page over its connection.
func Shell(title string, head ui.Node, children ui.Node) ui.Node {
	return <html lang="en">
		<head>
			<meta charset="utf-8" />
			<meta
				name="viewport"
				content="width=device-width, initial-scale=1"
			/>
			<title>{title} · Vuka live</title>
			<style>{css}</style>
			{head}
		</head>
		<body>
			<nav>
				<ui.Link href="/">Home</ui.Link> <ui.Link href="/counter">Counter</ui.Link> <ui.Link href="/todo">Todo</ui.Link>
				<ui.Link href="/chat/lobby">Chat</ui.Link> <ui.Link href="/commands">Commands</ui.Link> <ui.Link href="/chores">Chores</ui.Link>
				<ui.Link href="/likes">Likes</ui.Link> <ui.Link href="/books">Books</ui.Link>
			</nav>
			<main>{children}</main>
		</body>
	</html>
}

// livePage is the layout of the @web.Live pages.
func livePage(page ui.Node) ui.Node {
	return <Shell title="Live">{page}</Shell>
}

const css = `body { font: 16px/1.5 system-ui, sans-serif; max-width: 40rem; margin: 2rem auto; padding: 0 1rem }
nav a { margin-right: 1rem } [aria-busy=true] { opacity: .6 } .done { text-decoration: line-through; color: #888 }
.hidden, #menu:not(.open) { display: none } .dialog { border: 1px solid #ccc; padding: 1rem } .fade { transition: opacity .2s } .faded { opacity: 0 } .flash { background: #ffd }
html[data-vk-navigating] main { opacity: .6 }
html[data-vk-state=disconnected] body::before { content: "reconnecting…"; position: fixed; top: 0; right: 0; background: #fd0; padding: .2rem .6rem }`

// Home is an ordinary route: the counter in it makes the page live.
@web.Get("/")
func Home(r *http.Request) ui.Node {
	return <Shell title="Home">
		<h1>Vuka live</h1>
		<p>A counter inside an ordinary <code>@web.Get</code> page:</p>
		<Counter Start={10} />
		<p>Open <a href="/chat/lobby">the chat</a> in two tabs.</p>
	</Shell>
}
