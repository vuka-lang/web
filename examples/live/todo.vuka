package main

import (
	"slices"
	"strconv"
	"strings"

	"github.com/vuka-lang/web"
	"github.com/vuka-lang/ui"
)

type Item struct {
	ID   int
	Text string
	Done bool
}

type NewItem struct {
	Text string `form:"text"`
}

@web.Live("/todo")
type Todo struct {
	ui.Live
	items  []Item
	next   int
	filter string
	sorted bool
}

func (t *Todo) Add(f NewItem) error {
	text := strings.TrimSpace(f.Text)
	if text == "" {
		return web.BadRequest("write something first")
	}
	t.next++
	t.items = append(t.items, Item{ID: t.next, Text: text})
	return nil
}

func (t *Todo) Remove(id int) {
	t.items = slices.DeleteFunc(t.items, func(it Item) bool { return it.ID == id })
}

func (t *Todo) Toggle(id int, done bool) {
	for i := range t.items {
		if t.items[i].ID == id {
			t.items[i].Done = done
		}
	}
}

func (t *Todo) Filter(q string) { t.filter = q }

func (t *Todo) Sort() { t.sorted = !t.sorted }

func (t *Todo) shown() []Item {
	q := strings.ToLower(t.filter)
	out := slices.DeleteFunc(slices.Clone(t.items), func(it Item) bool { return !strings.Contains(strings.ToLower(it.Text), q) })
	if t.sorted {
		slices.SortStableFunc(out, func(a, b Item) int { return strings.Compare(strings.ToLower(a.Text), strings.ToLower(b.Text)) })
	}
	return out
}

func (t *Todo) left() int {
	n := 0
	for _, it := range t.items {
		if !it.Done {
			n++
		}
	}
	return n
}

func (t *Todo) Render() ui.Node {
	return <section class="todo">
		<form onSubmit={t.Add}>
			<input
				name="text"
				placeholder="What needs doing?"
				autocomplete="off"
			/>
			<button>Add</button>
		</form>
		<input
			type="search"
			placeholder="Filter"
			value={t.filter}
			onInput={t.Filter}
			data-vk-debounce="150"
		/>
		<button type="button" class="sort" onClick={t.Sort}>
			{sortLabel(t.sorted)}
		</button>
		<ul>
			{for _, it := range t.shown() {
				<li
					key={it.ID}
					id={"todo-" + strconv.Itoa(it.ID)}
					class={doneClass(it.Done)}
				>
					<input
						type="checkbox"
						checked={it.Done}
						onChange={func(done bool) { t.Toggle(it.ID, done) }}
					/>
					<span>{it.Text}</span>
					<button type="button" onClick={func() { t.Remove(it.ID) }}>
						×
					</button>
				</li>
			}}
		</ul>
		<p class="left">{t.left()} left</p>
	</section>
}

func sortLabel(sorted bool) string {
	if sorted {
		return "Unsort"
	}
	return "Sort A–Z"
}

func doneClass(done bool) string {
	if done {
		return "done"
	}
	return ""
}
