package main

import (
	"context"
	"errors"
	"slices"
	"strings"
	"sync"

	"github.com/vuka-lang/web"
)

// Said and Joined are what the chat broadcasts; each reaches its own Update.
type Said struct{ Who, Text string }
type Joined struct{ Who string }

type ChatForm struct {
	Text string `form:"text"`
}

// ChatLog keeps each room's history, so a page joining late sees it.
@web.Service
type ChatLog struct {
	mu    sync.Mutex          `inject:"-"`
	rooms map[string][]string `inject:"-"`
}

func (l *ChatLog) Add(room, line string) {
	l.mu.Lock()
	defer l.mu.Unlock()
	if l.rooms == nil {
		l.rooms = map[string][]string{}
	}
	l.rooms[room] = append(l.rooms[room], line)
}

func (l *ChatLog) History(room string) []string {
	l.mu.Lock()
	defer l.mu.Unlock()
	return slices.Clone(l.rooms[room])
}

// Chat is a room at /chat/{room}: Room binds from the path, Log is injected.
@web.Live("/chat/{room}")
type Chat struct {
	vuka.Live
	Room  string
	Log   *ChatLog
	lines []string
	name  string
}

func (c *Chat) topic() string { return "chat:" + c.Room }

func (c *Chat) Mount() {
	c.Subscribe(c.topic())
	c.lines = c.Log.History(c.Room)
}

func (c *Chat) Update(m Said)   { c.lines = append(c.lines, m.Who+": "+m.Text) }
func (c *Chat) Update(j Joined) { c.lines = append(c.lines, j.Who+" joined") }

func (c *Chat) SetName(ctx context.Context, f ChatForm) error {
	name := strings.TrimSpace(f.Text)
	if name == "" {
		return errors.New("pick a name")
	}
	c.name = name
	c.Log.Add(c.Room, name+" joined")
	return web.Broadcast(ctx, c.topic(), Joined{name})
}

func (c *Chat) Send(ctx context.Context, f ChatForm) error {
	if strings.TrimSpace(f.Text) == "" {
		return nil
	}
	c.Log.Add(c.Room, c.name+": "+f.Text)
	return web.Broadcast(ctx, c.topic(), Said{c.name, f.Text})
}

func (c *Chat) Render() vuka.Node {
	return <section class="chat">
		<h2>#{c.Room}</h2>
		<ul class="lines">
			{for _, l := range c.lines {
				<li>{l}</li>
			}}
		</ul>
		{if c.name == "" {
			<form class="name" onSubmit={c.SetName}>
				<input name="text" placeholder="Your name" autocomplete="off" />
				<button>Join</button>
			</form>
		} else {
			<form class="say" onSubmit={c.Send}>
				<input
					name="text"
					placeholder={"Say something, " + c.name}
					autocomplete="off"
				/>
				<button>Send</button>
			</form>
		}}
	</section>
}
