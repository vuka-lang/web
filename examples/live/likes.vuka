package main

import (
	"errors"
	"fmt"
	"slices"

	"github.com/vuka-lang/web"
	"github.com/vuka-lang/ui"
)

// Likes shows its outcomes before the server answers: a like counts at
// once, a deleted note goes at once, and both come back when the server
// refuses — likes while they're closed, the note that stays.
@web.Live("/likes")
type Likes struct {
	ui.Live
	likes  int
	closed bool
	notes  []string
}

func (l *Likes) Mount() { l.likes, l.notes = 5, []string{"milk", "eggs", "keep"} }

func (l *Likes) Like() error {
	if l.closed {
		return errors.New("likes are closed")
	}
	l.likes++
	return nil
}

func (l *Likes) Toggle() { l.closed = !l.closed }

func (l *Likes) Delete(e ui.Event) error {
	if e.Value == "keep" {
		return errors.New("that note stays")
	}
	l.notes = slices.DeleteFunc(l.notes, func(s string) bool { return s == e.Value })
	return nil
}

func (l *Likes) Render() ui.Node {
	cls := "like"
	if l.likes > 5 {
		cls += " liked"
	}
	return <section class="likes">
		<button
			id="like"
			class={cls}
			type="button"
			onClick={ui.JS.AddClass(ui.This, "liked").SetText(ui.Ref("count"), fmt.Sprint(l.likes+1)).
				Push(l.Like).OnError(ui.JS.Show(ui.Ref("like-error")))}
		>
			Like
		</button>
		<b ref="count">{l.likes}</b>
		<p ref="like-error" class="error" hidden>Couldn't save your like.</p>
		<button id="toggle" type="button" onClick={l.Toggle}>{closedLabel(l.closed)}</button>
		<ul class="notes">
			{for _, n := range l.notes {
				<li key={n} id={"note-" + n}>
					{n}
					<button
						type="button"
						value={n}
						onClick={ui.JS.Hide(ui.Closest("li")).Push(l.Delete).OnError(ui.JS.Show(ui.Ref("note-error")))}
					>
						delete
					</button>
				</li>
			}}
		</ul>
		<p ref="note-error" class="error" hidden>Couldn't delete that note.</p>
	</section>
}

func closedLabel(closed bool) string {
	if closed {
		return "Open likes"
	}
	return "Close likes"
}
