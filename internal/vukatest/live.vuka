package vukatest

import (
	"github.com/vuka-lang/ui/v2"
	"github.com/vuka-lang/web/v2"
)

// tally is the Tally of tally.vuka.html, as cards.templ's Board renders it.
func tally() ui.Node { return ui.Key(nil, &Tally{}) }

@web.Template("cards.templ", "Board")
@web.Get("/board")
func board() string { return "scores" }
